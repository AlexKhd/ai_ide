.min-h-screen.bg-slate-50.py-10
  .mx-auto.max-w-6xl.px-4
    .flex.items-center.justify-between.mb-8
      h1.text-3xl.font-bold Models

      .flex.items-center.gap-4
        = button_to "Sync Models",
          sync_models_ai_models_path,
          method: :post,
          data: { turbo: false },
          class: "rounded-xl bg-emerald-600 hover:bg-emerald-500 px-5 py-3 text-sm font-semibold text-white shadow-lg transition-all duration-200"

      .flex.items-center.gap-4
        = button_to "Apply Sync", apply_sync_ai_models_path, method: :post,
         data: { turbo_confirm: "Apply model changes?" }, class: "rounded-xl bg-blue-600 hover:bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-lg"

    - if @diffs.present?

      .mt-8.space-y-8

        - if @diffs[:added].any?
          .rounded-2xl.border.border-emerald-700.p-6
            h2.text-2xl.font-bold.text-emerald-300.mb-4
              | New Models

            table.table
              thead
                tr
                  th External ID
                  th Tools
                  th Reasoning
                  th Free

              tbody
                - @diffs[:added].each do |ai_model|
                  = render partial: "ai_models/ai_model_diffs", locals: { ai_model: ai_model }

        - else
          p.text-green No added models

        - if @diffs[:removed].any?
          .rounded-2xl.border.border-red-700.p-6
            h2.text-2xl.font-bold.text-red-300.mb-4
              | Removed Models

            table.table
              thead
                tr
                  th Name
                  th External ID

              tbody
                - @diffs[:removed].each do |model|
                  tr
                    td = model.name
                    td = model.external_id

        - if @diffs[:changed].any?
          .rounded-2xl.border.border-yellow-700.p-6
            h2.text-2xl.font-bold.text-yellow-300.mb-4
              | Changed Models

            - @diffs[:changed].each do |model|
              .mb-6.pb-6.border-b.border-yellow-800
                h3.text-lg.font-semibold.text-white
                  = model[:name]

                table.table.mt-3
                  thead
                    tr
                      th Field
                      th Old
                      th New

                  tbody
                    - model[:changes].each do |field, values|
                      tr
                        td = field
                        td = values[0]
                        td = values[1]

    .flex
      = button_to "Advanded only", ai_models_path, method: :get, params: {advanced_only: 1},
       class: "rounded-xl bg-blue-600 hover:bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-lg"
      = button_to "All", ai_models_path, method: :get,
       class: "ms-2 rounded-xl bg-blue-600 hover:bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-lg"


    table.table
      thead
        tr
          th ID
          th Name
          th External ID
          th Context Length
          th Tools
          th Reasoning
          th Free

      tbody
        = render @ai_models
