div class="min-h-screen bg-slate-50 py-10"
  .mx-auto.max-w-6xl.px-4

    .flex.items-center.justify-between.mb-8
      h1.text-3xl.font-bold.text-slate-900 Users

      = link_to "New User",
        new_user_path,
        class: "rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-purple-500"

    .overflow-hidden.rounded-2xl.bg-white.shadow.ring-1.ring-slate-200
      table.min-w-full.divide-y.divide-slate-200
        thead.bg-slate-50
          tr
            th.px-6.py-3.text-left.text-xs.font-semibold.text-slate-600.uppercase tracking-wider Email
            th.px-6.py-3.text-left.text-xs.font-semibold.text-slate-600.uppercase Role
            th.px-6.py-3.text-left.text-xs.font-semibold.text-slate-600.uppercase Created
            th.px-6.py-3.text-right.text-xs.font-semibold.text-slate-600.uppercase Actions

        tbody.divide-y.divide-slate-100
          - @users.each do |user|
            tr.hover:bg-slate-50
              td.px-6.py-4.text-sm.font-medium.text-slate-900
                = user.email_address

              td.px-6.py-4.text-sm
                - if user.admin?
                  span.inline-flex.rounded-full.bg-purple-100.px-2.py-1.text-xs.font-semibold.text-purple-700 Admin
                - else
                  span.inline-flex.rounded-full.bg-slate-100.px-2.py-1.text-xs.font-semibold.text-slate-700 User

              td.px-6.py-4.text-sm.text-slate-500
                = l(user.created_at, format: :short)

              td.px-6.py-4.text-right.text-sm.space-x-3
                = link_to "Edit",
                  edit_user_path(user),
                  class: "text-purple-600 hover:text-purple-500 font-medium"

                = link_to "Delete", user,
                 data: {turbo_method: :delete, turbo_confirm: "Delete this user?"},
                  class: "text-sm font-medium text-red-400 hover:text-red-300 transition-colors"
