.flex.items-center.justify-center.mb-8
  h1.text-3xl.font-bold.text-slate-900 Messages
  - if @ai_messages.any?
    .mt-2 = button_to "Delete All Messages", destroy_all_ai_messages_path, method: :delete,
    class: "ms-2 rounded-xl bg-red-600 hover:bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-lg"

- if @ai_messages.any?
  table.min-w-full.divide-y.divide-slate-500
    thead
      tr
        th ID/SID
        th Role
        th Content
        th Name
        th CID
        th Metadata
        th Created
    tbody.divide-y.divide-slate-300
      = render @ai_messages
- else
  .p-8.text-center
    p.text-sm.text-zinc-500 No messahges in the database.
