.flex.items-center.justify-center.mb-8
  h1.text-3xl.font-bold.text-slate-900 Messages
  - if @ai_messages.any?
    .mt-2.flex.items-center.gap-2
      = link_to "Refresh", ai_messages_path,
        class: "ms-2 rounded-xl bg-slate-700 hover:bg-slate-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition-all duration-200"
      = button_to "Delete All Messages", destroy_all_ai_messages_path, method: :delete,
        class: "rounded-xl bg-red-600 hover:bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-lg"

- if @ai_messages.any?
  table.min-w-full.divide-y.divide-slate-500
    thead
      tr
        th.px-4.py-2.text-left ID/SID
        th.px-4.py-2.text-left Role
        th.px-4.py-2.text-left Content
        th.px-4.py-2.text-left Name
        th.px-4.py-2.text-left CID
        th.px-4.py-2.text-left Metadata
        th.px-4.py-2.text-left Created
    tbody.divide-y.divide-slate-300
      = render @ai_messages
- else
  .p-8.text-center
    p.text-sm.text-zinc-500 No messages in the database.
