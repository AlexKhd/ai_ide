.p-6
  - if @ai_messages.any?

    = button_to "Clear All Messages", destroy_all_ai_messages_path, method: :delete,
    class: "ms-2 rounded-xl bg-red-600 hover:bg-blue-500 px-5 py-3 text-sm font-semibold text-white shadow-lg"

    table.table
      thead
        tr
          th ID/SID
          th Role
          th Content
          th Name
          th CID
          th Metadata
          th Created
      tbody
        = render @ai_messages
  - else
    .p-8.text-center
      p.text-sm.text-zinc-500 No messahges in the database.
