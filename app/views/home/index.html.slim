#navbar.text-3xl.text-heading
  p AI IDE

button#ask-ai.btn-ai.bg-purple-700.mt-1 Ask AI

div#editor style="width:100%; height:500px; border:1px solid #ccc;"

#ai-output.text-shadow-neon

script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs/loader.js"

javascript:
  require.config({ paths: { 'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs' }});
  require(['vs/editor/editor.main'], function() {
    // Store globally
    window.editor = monaco.editor.create(document.getElementById('editor'), {
      value: "// Write your Ruby code here\nputs 'Hello AI IDE!'",
      language: "ruby",
      theme: "vs-dark",
      automaticLayout: true
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const button = document.getElementById("ask-ai");
    const output = document.getElementById("ai-output");

    button.addEventListener("click", () => {
      if (!window.editor) {
        output.innerText = "Editor not ready yet!";
        return;
      }

      const code = window.editor.getValue(); // now works!
      fetch("/ai/code_suggest", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code: code })
      })
      .then(res => res.json())
      .then(data => {
        output.innerText = data.suggestion;
      });
    });
  });
