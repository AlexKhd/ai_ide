.min-h-screen.mt-4
  .mx-auto.max-w-2xl
    .text-2xl.font-bold.text-center
      = "Firewall #{@vserver.name} (#{@vserver.host})"

    .bg-white.rounded-xl.shadow-sm.ring-1.ring-gray-200.p-6
      h2.text-lg.font-semibold.text-gray-900 Firewall Status

    - if @firewall_result.success?
      - data = @firewall_result.data || {}

      p.mt-2.text-sm.text-gray-600
        = @firewall_result.message

      .mt-4
        span.inline-flex.items-center.rounded-full.px-3.py-1.text-sm.font-medium class=(data[:ufw_active] ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")
          = data[:ufw_active] ? "Firewall Active" : "Firewall Inactive"

      .mt-6
        h3.text-sm.font-semibold.text-gray-900 UFW Status

        pre.mt-2.overflow-x-auto.rounded-lg.bg-gray-900.p-4.text-sm.text-green-300 = data[:raw_status]

      .mt-6
        h3.text-sm.font-semibold.text-gray-900 Firewall Rules

        pre.mt-2.overflow-x-auto.rounded-lg.bg-gray-900.p-4.text-sm.text-green-300 = data[:raw_rules]

    - else
      .alert.alert-danger
        = @firewall_result.message

    .my-2 = button_to "Apply Firewall Baseline",
     configure_firewall_vserver_path(@vserver), method: :post,
      class: "rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-500",
       form: { data: { turbo_confirm: "This will enable UFW and apply the predefined firewall rules. Continue?" } }

    = link_to "Back to VPS", status_vserver_path(@vserver),
     class: "rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-500"
