= form_with(model: vserver, class: "space-y-6 max-w-2xl") do |form|
  - if vserver.errors.any?
    div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800"
      h2 class="font-semibold mb-2"
        = "#{pluralize(vserver.errors.count, "error")} prohibited this vserver from being saved:"
      ul class="list-disc pl-5 space-y-1 text-sm"
        - vserver.errors.each do |error|
          li = error.full_message

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
      div
        = form.label :name, class: "block text-sm font-medium text-gray-700 mb-1"
        = form.text_field :name, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

      div
        = form.label :host, class: "block text-sm font-medium text-gray-700 mb-1"
        = form.text_field :host, placeholder: "https://example.com", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

  div
    = form.label :healthcheck, class: "block text-sm font-medium text-gray-700 mb-1"
    = form.text_field :healthcheck, placeholder: "/up", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

  .grid.grid-cols-1.sm:grid-cols-2.gap-4
    div
      = form.label :port, class: "block text-sm font-medium text-gray-700 mb-1"
      = form.number_field :port, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

    div
      = form.label :ssh_port, class: "block text-sm font-medium text-gray-700 mb-1"
      = form.number_field :ssh_port, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

  div
    = form.label :username, class: "block text-sm font-medium text-gray-700 mb-1"
    = form.text_field :username, class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

  div
    = form.label :local_path, class: "block text-sm font-medium text-gray-700 mb-1"
    = form.text_field :local_path, placeholder: "/var/www/myapp", class: "block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500 focus:outline-none"

  div class="flex items-center gap-3"
    = form.checkbox :enabled, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
    = form.label :enabled, class: "text-sm font-medium text-gray-700"

  .flex.items-center.gap-3.pt-2
    = form.submit class: "inline-flex cursor-pointer items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
    = link_to "Back", vservers_path, class: "rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-purple-500"
