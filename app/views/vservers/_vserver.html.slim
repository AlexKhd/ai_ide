.w-full id="#{dom_id vserver}"
  .flex.items-center.justify-end.text-2xl.font-bold
    span = vserver.name
    - if vserver.enabled?
      .ms-4.inline-flex.items-center.rounded-full.bg-emerald-500.text-emerald-300.px-3.py-1.text-xs.font-semibold.border.border-emerald-500
        | enabled

  p
    strong Host:
    =< vserver.host
  p
    strong Healthcheck:
    =< vserver.healthcheck

  .flex.gap-8
    p
      strong App port:
      =< vserver.port
    p
      strong SSH port:
      =< vserver.ssh_port
  p
    strong Username:
    =< vserver.username
  p
    strong Local path:
    =< vserver.local_path

    hr
  .flex.gap-8
    p
      strong Server status:
      span class="ml-2 rounded px-2 py-1 text-sm font-medium #{vps_status_classes(vserver.server_status)}"
        = vserver.server_status || "Unknown"

    p
      strong App status:
      span class="ml-2 rounded px-2 py-1 text-sm font-medium #{vps_status_classes(vserver.app_status)}"
        = vserver.app_status || "Unknown"

  p
    strong Last check:
    =< vserver.last_checked_at ? "#{time_ago_in_words(vserver.last_checked_at)} ago" : "Never"
