.flex.items-center.justify-center.mb-8
  h1.text-3xl.font-bold VPS List

= turbo_stream_from "vservers"

- if @vservers.any?
  #vservers.grid.grid-cols-1.md:grid-cols-2.gap-6.p-3
    - @vservers.each do |vserver|
      = render "vserver_card", vserver: vserver

.p-3
  = link_to "Add VPS", new_vserver_path, class: "rounded-xl bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-purple-500"
