.min-h-screen.bg-slate-50.py-10
  .mx-auto.max-w-6xl.px-4
    .flex.items-center.justify-between.mb-8
      h1.text-3xl.font-bold App Folders
      = link_to "New Folder", new_app_folder_path, class: "rounded-xl bg-purple-600 px-4 py-2 text-white hover:bg-purple-500"

    table.w-full.bg-white.shadow.rounded-xl
      thead.bg-slate-100
        tr
          th.px-4.py-2 Name
          th.px-4.py-2 Path
          th.px-4.py-2 Language
          th.px-4.py-2 Active
          th.px-4.py-2 Created At
          th.px-4.py-2 Actions
      tbody
        - @app_folders.each do |folder|
          tr.border-t
            td.px-4.py-2 = folder.name
            td.px-4.py-2 = folder.path
            td.px-4.py-2 = folder.language
            td.px-4.py-2 = folder.active? ? "Yes" : "No"
            td.px-4.py-2 = folder.created_at.strftime("%Y-%m-%d %H:%M")
            td.px-4.py-2
              = link_to "Edit", edit_app_folder_path(folder), class: "text-blue-600 hover:underline mr-2"
              = link_to "Delete", app_folder_path(folder), method: :delete, data: {turbo_method: :delete, turbo_confirm: "Delete this folder?" }, class: "text-red-600 hover:underline"
