#navbar.p-3.flex.items-center
  .me-2.text-heading
    = link_to 'AI IDE - HOME', home_index_path,
      class: "rounded-xl border border-zinc-700 hover:border-zinc-500 bg-zinc-900 px-4 py-1 text-sm font-medium text-gray-300 hover:text-white transition-all duration-200"

  .me-3
    = link_to 'Connections', ai_connections_path,
      class: "rounded-xl border border-zinc-700 hover:border-zinc-500 bg-zinc-900 px-4 py-1 text-sm font-medium text-gray-300 hover:text-white transition-all duration-200"

  .me-3(data-controller="dropdown")
    button.rounded-xl.border.border-zinc-700.hover:border-zinc-500.bg-zinc-900.px-4.py-1.text-sm.font-medium.text-gray-300.hover:text-white.transition-all.duration-200.flex.items-center.gap-2(
      data-action="click->dropdown#toggle"
      data-dropdown-target="trigger"
      type="button"
    )
      span Menu
      svg.w-4.h-4(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3")

    .absolute.mt-2.w-48.rounded-lg.border.border-zinc-600.bg-zinc-800.shadow-lg.hidden(
      data-dropdown-target="menu"
    )
      = link_to 'Users', users_path,
        class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-zinc-700 transition-all duration-200 rounded-t-lg"
      = link_to 'Projects', app_folders_path,
        class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-zinc-700 transition-all duration-200 rounded-b-lg"
      = link_to 'Models', ai_models_path,
        class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-zinc-700 transition-all duration-200 rounded-b-lg"
      = link_to 'Tools', mcp_tools_path,
        class: "block w-full text-left px-4 py-2 text-sm font-medium text-gray-300 hover:text-white hover:bg-zinc-700 transition-all duration-200 rounded-b-lg"

  - if current_connection
    .me-3
      = "Connection: #{current_connection.name}/#{current_connection.ai_model.external_id}"
  - else
    .me-3
      = "NO Current connection"

  .me-3
    - if AiModel.last
      = "LLMs last update: #{AiModel.last.updated_at.in_time_zone.strftime("%H:%M")}"
    - else
      = "LLMs list last update: Never"

  .flex.ml-auto.text-gray-400.text-sm.items-center
    = "v. #{Rails.application.credentials.app_version}"
    - if current_user
      .ms-2.me-2 = current_user.nickname || current_user.email_address
      = link_to "Logout", session_path, data: { turbo_method: :delete },
       class: "rounded-xl border border-red-700 bg-red-900 px-2 py-1 text-sm font-medium text-red-200 hover:bg-red-800"
